{
  "eval": { },
  "formatting": {
    "command": [ "nixfmt" ]
  },
  "nixpkgs": {
    "expr": "(builtins.getFlake (builtins.toString ./.)).inputs.nixpkgs.legacyPackages.${builtins.currentSystem}"
  },
  "options": {
    "nixvim": {
      "expr": "(builtins.getFlake (builtins.toString ./.)).packages.${builtins.currentSystem}.nvim.options"
    }
  }
}
